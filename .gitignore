# Raw data snapshots — code is pushed, data is re-seeded separately
data/data_files/*

# Trained model artifacts — regenerated by retraining, not committed
ml/artifacts/*

# Backup files (e.g. supplementary.csv.gz.bak-20260804T142647, sell_high_gbm.joblib.bak_predecile)
*.bak
*.bak-*
*.bak_*

# Downloaded/derived ingestion cache — re-fetched by scripts/ingest_historical_market_value/fetch.py
.cache/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors
.vscode/
.idea/

# AI-tooling config — regenerated per session, not project source
.claude/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# Logs
*.log

# Environment
.env
.env.local

# OS junk
.DS_Store
Thumbs.db
